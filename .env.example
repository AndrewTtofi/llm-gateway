# Copy to .env — never commit .env
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: other providers in the `frontier` alias. Without a key, the gateway skips them.
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway

# Bootstrap admin key for /admin endpoints (generate: python -c "import secrets;print('gw_admin_'+secrets.token_urlsafe(24))")
GATEWAY_ADMIN_KEY=

LOG_LEVEL=INFO
# Chaos provider for tests/demos (docker-compose sets it for the dev stack). Never in production.
# GATEWAY_ENABLE_FAKE=1
CONFIG_DIR=/app/config

# Grafana image renderer (compose profile "screenshots"); set a random value outside local dev
# GRAFANA_RENDERER_TOKEN=
# Breaker alerts (ADR 0019): a Slack-compatible incoming-webhook URL. Unset = no alerts.
ALERT_WEBHOOK_URL=
