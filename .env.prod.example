# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# Generate secrets with: openssl rand -hex 32   (hex: they go into connection URLs as-is)
GATEWAY_VERSION=1.2.0
GATEWAY_DOMAIN=llm.example.com
GATEWAY_ADMIN_KEY=
REDIS_PASSWORD=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PG_PASSWORD=
USAGE_RETENTION_DAYS=90

# Provider keys: a provider without its key is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://ollama-host:11434/v1

LOG_LEVEL=INFO
# Never set GATEWAY_ENABLE_FAKE in production.
