# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# Generate secrets with: openssl rand -hex 32   (hex: they go into connection URLs as-is;
# GATEWAY_ADMIN_KEY should be at least 32 characters, GRAFANA_PG_PASSWORD ASCII)
GATEWAY_VERSION=1.3.1
GATEWAY_DOMAIN=llm.example.com
GATEWAY_ADMIN_KEY=
REDIS_PASSWORD=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PG_PASSWORD=
USAGE_RETENTION_DAYS=90
BACKUP_KEEP_DAYS=14                  # daily pg_dump kept this long (copy the volume off-host too)

# Provider keys: a provider without its key is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://ollama-host:11434/v1

# Response-cache Redis memory cap (only used by aliases with a `cache:` block).
CACHE_MAXMEMORY=512mb

LOG_LEVEL=INFO
# Never set GATEWAY_ENABLE_FAKE in production.
# Breaker alerts (ADR 0019): a Slack-compatible incoming-webhook URL. Unset = no alerts.
ALERT_WEBHOOK_URL=
# Prometheus alerts (SLO burn, Redis failing open, …) via Alertmanager, monitoring profile.
# A Slack-compatible incoming-webhook URL; unset = only on Alertmanager's page.
ALERTMANAGER_SLACK_URL=
